  inventorySheet.appendRow(["ITM_06", "Toor Dal (1kg)", "GRP_VEG", true, "LOW_STOCK"]);
  inventorySheet.appendRow(["ITM_07", "Tata Tea Gold", "GRP_TEA", true, "OUT_OF_STOCK"]);
  inventorySheet.appendRow(["ITM_08", "Milk (1L)", "GRP_ALL", true, "LOW_STOCK"]);
  inventorySheet.appendRow(["ITM_09", "Garbage Bags", "GRP_ALL", true, "IN_STOCK"]);
  inventorySheet.appendRow(["ITM_10", "Maggi (6 Pack)", "GRP_ALL", false, "IN_STOCK"]);

  // 5. Seed Historical Expenses to test Settlement Math
  const expensesSheet = clearSheetData("fact_expense_logs");
  const yesterday = new Date(new Date().setDate(new Date().getDate() - 1)).toISOString();
  const twoDaysAgo = new Date(new Date().setDate(new Date().getDate() - 2)).toISOString();

