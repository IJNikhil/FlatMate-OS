function seedDatabase() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // Helper function to wipe old test data before inserting new data
  function clearSheetData(sheetName) {
    const sheet = ss.getSheetByName(sheetName);
    if (sheet && sheet.getLastRow() > 1) {
      sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).clearContent();
    }
    return sheet;
  }

  // 1. Seed Members (4 Flatmates)
  const membersSheet = clearSheetData("dim_members");
  membersSheet.appendRow(["USR_01", "Siddharth", "siddharth@ybl", true]);
  membersSheet.appendRow(["USR_02", "Rahul", "rahul@okhdfcbank", true]);
  membersSheet.appendRow(["USR_03", "Amit", "amit@icici", true]);
  membersSheet.appendRow(["USR_04", "Vikram", "vikram@paytm", true]);

  // 2. Seed Groups
  const groupsSheet = clearSheetData("dim_groups");
  groupsSheet.appendRow(["GRP_ALL", "Global Household", 10000]);
  groupsSheet.appendRow(["GRP_VEG", "Vegetarian Staples", 4000]);
  groupsSheet.appendRow(["GRP_NONVEG", "Non-Veg Pool", 3000]);
  groupsSheet.appendRow(["GRP_TEA", "Chai Lovers", 1000]);

  // 3. Seed Member-to-Group Mapping
  const mapSheet = clearSheetData("map_member_group");
