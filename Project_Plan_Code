  // 4. Seed Inventory Items
  const inventorySheet = clearSheetData("dim_inventory");
  inventorySheet.appendRow(["ITM_01", "Cooking Oil (1L)", "GRP_ALL", true, "LOW_STOCK"]);
  inventorySheet.appendRow(["ITM_02", "Dishwash Liquid", "GRP_ALL", true, "OUT_OF_STOCK"]);
